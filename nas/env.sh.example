# drive-index NAS 설정 — install.sh 가 env.sh 로 복사함 (chmod 600: 관리자만 읽기)
# Gemini API 키: 여기 한 줄만 직접 넣으세요. 채팅·드라이브·web 폴더에는 절대 두지 마세요.
export GEMINI_API_KEY=""

# PC가 내보내는 폴더 (PC .env 의 EXPORT_DIR=\\PCHSNAS\web\drive-index 와 같은 곳)
export DRIVE_INDEX_DIR="/volume1/web/drive-index"
# 검색 API 포트 → http://192.168.0.250:8765/drive-index/api/search?q=...
export API_PORT="8765"

# 드라이브 위치 (rclone 리모트 이름 gdrive)
export SKEL_REMOTE="gdrive:건축시공기술사/_답안골격_교재그림/gemini"
export EXPORT_REMOTE="gdrive:건축시공기술사/_drive_index_export"
# 골격 생성 모델 (드라이브 gemini/model.txt 가 있으면 그게 우선, 여기 적으면 이게 우선)
# export SKEL_MODEL="gemini-flash-latest"
# 한 번 실행에 만들 최대 문제 수 (0 = 기본 40문제). 유료 키면 문제당 비용이 들므로 너무 크게 하지 마세요
export SKEL_MAX="0"
