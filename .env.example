# ── Google Drive 인증 (둘 중 하나) ──────────────────────────────
# 1) 서비스 계정 JSON (권장: 대상 폴더를 서비스 계정 이메일과 '공유'하세요)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# 2) OAuth 클라이언트(데스크톱 앱) JSON — 처음 실행 시 브라우저 로그인
# GOOGLE_OAUTH_CLIENT_FILE=credentials.json

# ── AI 비전 분석 (비용 최소화 라우팅) ────────────────────────────
# auto   : Gemini(저가) 우선 → 실패/한도초과 시 OpenAI로 폴백
# gemini : Gemini만 / openai : OpenAI만 / none : AI 없이 로컬 분석만 (비용 0)
VISION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# 한 번 인덱싱 시 AI 호출 최대 횟수 (예산 안전장치, 0 = 무제한)
VISION_MAX_CALLS=500
# AI로 보낼 이미지의 긴 변 픽셀 (작을수록 토큰/비용 감소)
VISION_IMAGE_PX=768

# 필기 인식: on 이면 손글씨를 받아 적어 검색 가능 (비용 약간 증가), off 면 그림/표만
HANDWRITING=on
# 필기 인식 시 AI로 보낼 이미지 크기 (작은 글씨가 안 읽히면 1600 정도로 올리세요)
HANDWRITING_IMAGE_PX=1280

# ── 렌더링 / 저장 ────────────────────────────────────────────────
DATA_DIR=data
PAGE_DPI=110

# ── NAS 보기 전용 사이트 (DS216play 등 Docker 안 되는 NAS용) ─────
# NAS Web Station의 web 공유폴더 경로. 설정하면 색인이 끝날 때마다 자동으로 내보냄
# Windows 예: EXPORT_DIR=\\DS216play\web\drive-index   Mac 예: EXPORT_DIR=/Volumes/web/drive-index
EXPORT_DIR=
